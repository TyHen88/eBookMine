// Expanded Prisma Schema for eBookMine (Neon PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  readingProgresses ReadingProgress[]
  bookmarks         Bookmark[]
  highlights        Highlight[]
  notes             Note[]
  readingGoals      ReadingGoal[]
  aiConversations   AIConversation[]
  aiUsages          AIUsage[]
  quizzes           Quiz[]
  quizAttempts      QuizAttempt[]
  flashcards        Flashcard[]
  readingLogs       ReadingLog[]
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String   // "VERIFY_EMAIL" | "FORGOT_PASSWORD"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

model Book {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  driveFileId String?  @unique
  fileName    String   @default("")
  mimeType    String   @default("application/pdf")
  pageCount   Int      @default(0)
  sizeBytes   BigInt   @default(0)
  favorite    Boolean  @default(false)
  language    String?  @default("en")
  visibility  String   @default("PRIVATE")
  published   Boolean  @default(true)
  ingestionStatus   String    @default("PENDING")
  ingestionError    String?   @db.Text
  documentHash      String?   @db.Text
  ingestedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  authors            BookAuthor[]
  categories         BookCategory[]
  readingProgresses  ReadingProgress[]
  bookmarks          Bookmark[]
  highlights         Highlight[]
  notes              Note[]
  aiConversations    AIConversation[]
  contentChunks      ContentChunk[]
  documentPages      DocumentPage[]
  documentStructures DocumentStructure[]
  documentSummaries  DocumentSummary[]
  quizzes            Quiz[]
  flashcards         Flashcard[]

  @@index([driveFileId])
  @@index([published, visibility])
  @@index([published, createdAt])
  @@index([title])
  @@index([createdAt])
  @@index([ingestionStatus])
}

model Author {
  id        String   @id @default(cuid())
  name      String   @unique
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books BookAuthor[]

  @@index([name])
}


model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books BookCategory[]

  @@index([slug])
}

model BookAuthor {
  bookId   String
  authorId String

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@index([bookId])
  @@index([authorId])
}

model BookCategory {
  bookId     String
  categoryId String

  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([bookId, categoryId])
  @@index([bookId])
  @@index([categoryId])
}

model ReadingProgress {
  id                 String    @id @default(cuid())
  userId             String
  bookId             String
  currentPage        Int       @default(1)
  totalPages         Int       @default(0)
  progressPercentage Float     @default(0.0)
  lastReadAt         DateTime  @default(now())
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@index([lastReadAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  page      Int
  title     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
}

model Highlight {
  id           String   @id @default(cuid())
  userId       String
  bookId       String
  page         Int
  selectedText String
  color        String?  @default("yellow")
  position     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  page      Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
}

model ReadingGoal {
  id        String    @id @default(cuid())
  userId    String
  type      String
  target    Int
  period    String
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  bookId    String?
  title     String   @default("Book Assistant Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)

  messages AIMessage[]

  @@index([userId])
  @@index([bookId])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  page           Int?
  selectedText   String?
  tokensUsed     Int      @default(0)
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIUsage {
  id        String   @id @default(cuid())
  userId    String
  action    String
  tokens    Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model DocumentPage {
  id               String   @id @default(cuid())
  bookId           String
  pageNumber       Int
  text             String   @db.Text
  extractionStatus String   @default("COMPLETED") // "PENDING" | "EXTRACTING" | "COMPLETED" | "FAILED"
  layoutMetadata   String?  @db.Text
  tokenCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, pageNumber])
  @@index([bookId])
}

model DocumentStructure {
  id            String   @id @default(cuid())
  bookId        String
  title         String
  level         Int      @default(1) // 1 = Chapter, 2 = Section, 3 = Subsection
  parentId      String?
  pageStart     Int
  pageEnd       Int
  orderingIndex Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  book          Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  parent        DocumentStructure?  @relation("SectionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          DocumentStructure[] @relation("SectionHierarchy")
  contentChunks     ContentChunk[]
  documentSummaries DocumentSummary[]

  @@index([bookId])
  @@index([bookId, orderingIndex])
}

model DocumentSummary {
  id             String   @id @default(cuid())
  bookId         String
  level          String   // "BOOK" | "CHAPTER" | "SECTION"
  chapterTitle   String?
  sectionId      String?
  summary        String   @db.Text
  pageStart      Int      @default(1)
  pageEnd        Int      @default(1)
  sourceChunkIds String   @db.Text // JSON string array of ContentChunk.id
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  book    Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  section DocumentStructure? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([bookId, level])
  @@index([sectionId])
}

model ContentChunk {
  id             String   @id @default(cuid())
  bookId         String
  chapter        String?
  page           Int
  pageStart      Int      @default(1)
  pageEnd        Int      @default(1)
  sectionId      String?
  chunkIndex     Int      @default(0)
  content        String   @db.Text
  tokenCount     Int      @default(0)
  contentHash    String?
  embeddingModel String?
  embeddingDim   Int?
  isStale        Boolean  @default(false)
  metadata       String?  @db.Text
  createdAt      DateTime @default(now())

  book    Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  section DocumentStructure? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([bookId, page])
  @@index([bookId, pageStart])
  @@index([bookId, isStale])
  @@index([sectionId])
}

model Quiz {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  title     String
  page      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([userId])
  @@index([bookId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  type          String   // "multiple_choice" | "true_false" | "short_answer" | "explanation"
  question      String
  options       String?  // JSON string array for multiple choice
  correctAnswer String
  explanation   String?
  page          Int?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  answers QuizAnswer[]

  @@index([quizId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  userId    String
  score     Float
  total     Int
  createdAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  answers QuizAnswer[]

  @@index([quizId])
  @@index([userId])
}

model QuizAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  userAnswer String
  isCorrect  Boolean

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
}

model Flashcard {
  id             String    @id @default(cuid())
  userId         String
  bookId         String
  chapter        String?
  page           Int?
  question       String
  answer         String
  difficulty     String    @default("medium") // "easy" | "medium" | "hard"
  dueDate        DateTime  @default(now())
  interval       Int       @default(1)
  repetition     Int       @default(0)
  easeFactor     Float     @default(2.5)
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@index([userId, dueDate])
}

model ReadingLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  minutes   Int      @default(0)
  pagesRead Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model EmbeddingCache {
  id          String   @id @default(cuid())
  contentHash String   @unique
  model       String
  dimensions  Int      @default(64)
  vectorJson  String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contentHash])
  @@index([model, dimensions])
}

